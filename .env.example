# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB Atlas or local MongoDB instance.
# If omitted or unavailable in preview, View Point falls back seamlessly to an interactive in-memory/file database.
MONGODB_URI="mongodb+srv://user:password@cluster0.mongodb.net/viewpoint?retryWrites=true&w=majority"

# JWT_SECRET & JWT_REFRESH_SECRET: Used for signing access and refresh authentication tokens.
JWT_SECRET="viewpoint-super-secret-jwt-key-2026"
JWT_REFRESH_SECRET="viewpoint-super-secret-refresh-key-2026"

# GMAIL_USER & GMAIL_APP_PASSWORD: Used for sending real Gmail emails upon Sign In / Sign Up.
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
